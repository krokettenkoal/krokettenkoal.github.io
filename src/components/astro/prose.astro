	class={cn('prose prose-neutral lg:prose-xl dark:prose-invert prose-h2:font-bold prose-h2:text-2xl prose-a:underline prose-p:text-justify prose-figure:my-8 prose-figure:-mx-2 prose-figcaption:text-muted-foreground prose-figcaption:text-center lg:prose-img:rounded-xl prose-img:object-cover prose-img:object-center', className)}>
	<slot />
</div>