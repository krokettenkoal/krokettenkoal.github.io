---
import type { CollectionEntry } from 'astro:content';
import { BentoCard, BentoGrid } from '@/components/ui/bento-grid';
import { Image } from 'astro:assets';

interface Props {
	projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;

const gridSizes = {
	1: 'col-span-3 lg:col-span-1',
	2: 'col-span-3 lg:col-span-2',
	3: 'col-span-3 lg:col-span-3'
};
---

<BentoGrid client:visible>
	{projects.map((project, idx) => (
		<BentoCard
			client:visible
			key={idx}
			href={`/projects/${project.id}`}
			name={project.data.title}
			description={project.data.description}
			cta="Explore project"
			tags={project.data.tags}
			className={gridSizes[project.data.gridSize]}
		>
			<Image src={project.data.thumbnail} alt={project.data.thumbnailAlt ?? project.data.title}
						 class="w-full h-full object-cover object-center" />
		</BentoCard>
	))}
</BentoGrid>