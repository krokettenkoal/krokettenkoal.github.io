---
import RootLayout from '@/layouts/root-layout.astro';
import { ButtonScrollTo } from '@/components/react/button-scroll-to';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
const featuredProjects = await getCollection('projects', ({ data }) => data.featured);
---

<RootLayout>
	<main class="container mx-auto">
		<section class="w-full h-svh flex justify-between items-center flex-col p-2">
			<div></div>
			<div class="text-center">
				<h1 class="scroll-m-20 text-5xl font-black lg:text-6xl">
					Hello there!
				</h1>
				<p class="text-muted-foreground text-xl mt-4">
					Thanks for stopping by.
				</p>
				<p class="text-muted-foreground text-xl">
					Feel free to look around or jump to my <a href="/projects">projects</a> or <a
					href="/bio">bio</a> page right away.
				</p>
			</div>

			<ButtonScrollTo client:idle
											targetSelector="#featured-projects" variant="outline" size="icon"
											className="size-12 rounded-full motion-safe:md:not-data-clicked:animate-bounce">
				<Icon name="lucide:arrow-down" />
			</ButtonScrollTo>
		</section>

		<section id="featured-projects" class="w-full p-2 my-10">
			<h2>Featured Projects</h2>
			<ul>
				{featuredProjects.map(project => (
					<li>
						<a href={`/projects/${project.id}`}>
							<h3>{project.data.title}</h3>
							<p>{project.data.description}</p>
						</a>
					</li>
				))}
			</ul>
		</section>
	</main>
</RootLayout>