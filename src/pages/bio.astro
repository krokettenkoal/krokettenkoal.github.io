---
import RootLayout from '@/layouts/root-layout.astro';
import {BlurFade} from "@/components/ui/blur-fade.tsx";
import {Separator} from "@/components/ui/separator.tsx";
import {BentoGrid, BentoCard} from "@/components/ui/bento-grid.tsx";
import {Marquee} from "@/components/ui/marquee.tsx";
import {Icon} from 'astro-icon/components';
import {Badge} from "@/components/ui/badge";
import {Image} from 'astro:assets';
import photoCajetan from "../assets/img/cajetan.jpeg";
import iconDst from '../assets/img/dst-icon.png';
import iconUstp from '../assets/img/ustp-icon.png';
import wwiseCertifiedInstructor from '../assets/img/wwise-certified-instructor.png';
import wwiseCertifiedInstructorDark from '../assets/img/wwise-certified-instructor_dark.png';
import wwiseUnityIntegration from '../assets/img/wwise-unity-integration.png';
import wwiseUnityIntegrationDark from '../assets/img/wwise-unity-integration_dark.png';
import wwiseFundamentals from '../assets/img/wwise-fundamentals.png';
import wwiseFundamentalsDark from '../assets/img/wwise-fundamentals_dark.png';
import winServer from '../assets/img/win-server.png';
import msO365 from '../assets/img/ms-o365.png';
