---
import '@fontsource/geist-sans';
import '../styles/global.css';
import {SEO} from 'astro-seo';
import {ModeToggle} from '@/components/react/mode-toggle';
import {Icon} from 'astro-icon/components';
import {cn} from '@/lib/utils';
import {buttonVariants} from '@/components/ui/button.tsx';
import {ScrollObserver} from 'astro-scroll-observer';
import {ClientRouter} from "astro:transitions";
import Nav, {type NavLink} from '@/components/astro/nav.astro';

interface Props {
    title?: string;
    description?: string;
}

const navLinks: NavLink[] = [
    {
        href: '/',
        label: 'Home',
        icon: 'lucide:home'
    },
    {
        href: '/projects',
        label: 'Projects',
        icon: 'lucide:sparkles',
        match: '^/projects'
    },
    {
        href: '/bio',
        label: 'Bio',
        icon: 'lucide:user'
    }
] as const;
const socialLinks = [
    {
        href: 'https://github.com/krokettenkoal',
        iconName: 'thesvg:github',
        label: 'Visit me on GitHub'
    },
    {
        href: 'https://www.linkedin.com/in/cajetan-grill/',
        iconName: 'devicon-plain:linkedin',
        label: 'Visit me on LinkedIn'
    }
] as const;
const {title = '', description = 'I create stuff on my laptop.'} = Astro.props;
---

<script is:inline>
    const getThemePreference = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
            return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    };

    const applyThemePreference = () => {
        const isDark = getThemePreference() === 'dark';
        document.documentElement.classList.toggle('dark', isDark);
    };

    // apply the theme preference on initial load
    applyThemePreference();

    let observer;
    if (typeof localStorage !== 'undefined') {
        observer = new MutationObserver(() => {
            const isDark = document.documentElement.classList.contains('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
    }

    document.addEventListener('astro:page-load', () => {
        // observe the document element for class changes to update the theme preference in localStorage
        observer?.observe(document.documentElement, {attributes: true, attributeFilter: ['class']});
    });

    document.addEventListener('astro:before-swap', () => {
        // disconnect the observer before the page swap to avoid unnecessary mutations during the transition
        observer?.disconnect();
    });

    // restore the theme preference after the page swap to ensure the correct theme is applied
    document.addEventListener('astro:after-swap', applyThemePreference);

</script>

<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width"/>
    <meta name="generator" content={Astro.generator}/>
    <link rel="icon" type="image/png" href="/images/favicon.png"/>
    <link rel="sitemap" href="/sitemap-index.xml"/>
    <ClientRouter/>
    <ScrollObserver/>
    <SEO title={title} titleTemplate="%s — Cajetan Grill" titleDefault="Cajetan Grill" description={description}/>
</head>
<body>
<header transition:persist
        class="sticky top-0 left-0 right-0 h-header z-50 flex justify-between items-center py-2 px-5">
    <div></div>
    <Nav items={navLinks}/>
    <div></div>
</header>

<slot/>

<footer transition:persist
        class="container mx-auto mt-8 mb-2 flex justify-between items-center flex-col gap-4 lg:mt-12 lg:mb-4 lg:flex-row">
    <menu class="flex gap-3">
        {socialLinks.map(socialLink => (
                <li>
                    <a href={socialLink.href} target="_blank" rel="noopener noreferrer"
                       class={cn("size-6 text-muted-foreground hover:text-foreground transition-colors", socialLink.className)}
                       aria-label={socialLink.label}>
                        <Icon name={socialLink.iconName} class="size-6"/>
                    </a>
                </li>
        ))}
    </menu>
    <div class="text-center text-sm text-muted-foreground">
        <p>&copy; {new Date().getFullYear()} Cajetan Grill. All rights reserved.</p>
        <p>
            Made with 💜 using <a href="https://astro.build" class="underline hover:text-primary">Astro</a>,{' '}
            <a href="https://reactjs.org" class="underline hover:text-foreground">React</a>,{' '}
            <a href="https://ui.shadcn.com/" class="underline hover:text-primary">shadcn/ui</a>, and{' '}
            <a href="https://magicui.design/" class="underline hover:text-primary">Magic UI</a>.
        </p>
    </div>
    <menu class="flex justify-end">
        <li>
            <ModeToggle client:idle/>
        </li>
    </menu>
</footer>
</body>
</html>

<style>
    @supports (container-type: scroll-state) {
        header {
            container-type: scroll-state;
        }
    }
</style>