---
import '@fontsource/geist-sans';
import '../styles/global.css';
import { SEO } from 'astro-seo';
import { ModeToggle } from '@/components/react/mode-toggle';
import { Icon } from 'astro-icon/components';
import { cn } from '@/lib/utils';
import { buttonVariants } from '@/components/ui/button.tsx';

interface Props {
	title?: string;
	description?: string;
}

interface NavLink {
	href: string;
	label: string;
	iconName: string;
	isActive?: (pathname: string) => boolean;
}

const navLinks: NavLink[] = [
	{
		href: '/',
		label: 'Home',
		iconName: 'lucide:home'
	},
	{
		href: '/projects',
		label: 'Projects',
		iconName: 'lucide:folder-open',
		isActive: (pathname) => pathname.startsWith('/projects')
	},
	{
		href: '/bio',
		label: 'Bio',
		iconName: 'lucide:user'
	}
];

const { title, description = 'I create stuff on my laptop.' } = Astro.props;
const { pathname } = Astro.url;
---

<script is:inline>
	const getThemePreference = () => {
		if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
			return localStorage.getItem('theme');
		}
		return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
	};
	const isDark = getThemePreference() === 'dark';
	document.documentElement.classList[isDark ? 'add' : 'remove']('dark');

	if (typeof localStorage !== 'undefined') {
		const observer = new MutationObserver(() => {
			const isDark = document.documentElement.classList.contains('dark');
			localStorage.setItem('theme', isDark ? 'dark' : 'light');
		});
		observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
	}
</script>

<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width" />
	<meta name="generator" content={Astro.generator} />
	<link rel="icon" type="image/png" href="/images/favicon.png" />
	<link rel="sitemap" href="/sitemap-index.xml" />
	<SEO title={title} titleTemplate="%s | Cajetan Grill" titleDefault="Cajetan Grill" description={description} />
	</head>
<body>
<header
	class="fixed bg-background/60 max-lg:bottom-0 lg:top-0 left-0 right-0 h-16 backdrop-blur-xl z-50 max-lg:border-t-2 lg:border-b-2">
	<div class="h-full flex justify-between items-center py-2 px-5">
		<div></div>
		<nav class="grow">
			<ul
				class="flex justify-center items-center gap-10 lg:gap-8"
			>
				{navLinks.map(navLink => (
					<li>
						<a href={navLink.href}
							 class={cn(buttonVariants({ variant: 'link' }), ['flex items-center gap-1 text-muted-foreground transition-colors hover:underline hover:text-foreground', { 'text-foreground font-semibold underline underline-offset-4 decoration-2': (navLink.isActive?.(pathname) ?? pathname === navLink.href) }])}>
							<Icon name={navLink.iconName} class="size-6 lg:size-4" />
							<span class="hidden md:block">
								{navLink.label}
							</span>
						</a>
					</li>
				))}
			</ul>
		</nav>
		<div>
			<ModeToggle client:load />
		</div>
	</div>
</header>

<slot />

<footer>
	<div class="container mx-auto p-4 text-center text-sm text-muted-foreground">
		<p>&copy; {new Date().getFullYear()} Cajetan Grill. All rights reserved.</p>
		<p>
			Made with 💜 using <a href="https://astro.build" class="underline hover:text-primary">Astro</a>,{' '}
			<a href="https://reactjs.org" class="underline hover:text-primary">React</a>, and{' '}
			<a href="https://tailwindcss.com" class="underline hover:text-primary">Tailwind CSS</a>.
		</p>
	</div>
</footer>
</body>
</html>