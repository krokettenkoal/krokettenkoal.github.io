---
import '@fontsource/geist-sans';
import '../styles/global.css';
import {SEO} from 'astro-seo';
import {ModeToggle} from '@/components/react/mode-toggle';
import {Icon} from 'astro-icon/components';
import {cn} from '@/lib/utils';
import {buttonVariants} from '@/components/ui/button.tsx';

interface Props {
    title?: string;
    description?: string;
}

interface NavLink {
    href: string;
    label: string;
    iconName: string;
    isActive?: (pathname: string) => boolean;
}

const navLinks: NavLink[] = [
    {
        href: '/',
        label: 'Home',
        iconName: 'lucide:home'
    },
    {
        href: '/projects',
        label: 'Projects',
        iconName: 'lucide:sparkles',
        isActive: (pathname) => pathname.startsWith('/projects')
    },
    {
        href: '/bio',
        label: 'Bio',
        iconName: 'lucide:user'
    }
] as const;

const socialLinks = [
    {
        href: 'https://github.com/krokettenkoal',
        iconName: 'thesvg:github',
        label: 'Visit me on GitHub'
    },
    {
        href: 'https://www.linkedin.com/in/cajetan-grill/',
        iconName: 'devicon-plain:linkedin',
        label: 'Visit me on LinkedIn'
    }
] as const;

const {title = '', description = 'I create stuff on my laptop.'} = Astro.props;
const {pathname} = Astro.url;
---

<script is:inline>
    const getThemePreference = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
            return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    };
    const isDark = getThemePreference() === 'dark';
    document.documentElement.classList[isDark ? 'add' : 'remove']('dark');

    if (typeof localStorage !== 'undefined') {
        const observer = new MutationObserver(() => {
            const isDark = document.documentElement.classList.contains('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
        observer.observe(document.documentElement, {attributes: true, attributeFilter: ['class']});
    }
</script>

<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width"/>
    <meta name="generator" content={Astro.generator}/>
    <link rel="icon" type="image/png" href="/images/favicon.png"/>
    <link rel="sitemap" href="/sitemap-index.xml"/>
    <SEO title={title} titleTemplate="%s — Cajetan Grill" titleDefault="Cajetan Grill" description={description}/>
</head>
<body>
<header
        class="sticky bg-background/60 top-0 left-0 right-0 h-header backdrop-blur-xl z-50 border-b-2">
    <div class="h-full flex justify-between items-center py-2 px-5">
        <div></div>
        <nav class="grow">
            <ul
                    class="flex justify-center items-center gap-10 lg:gap-8"
            >
                {navLinks.map(navLink => (
                        <li>
                            <a href={navLink.href}
                               class={cn(buttonVariants({variant: 'link'}), ['flex items-center gap-1 text-muted-foreground transition-colors hover:underline hover:text-foreground', {'text-foreground font-semibold': (navLink.isActive?.(pathname) ?? pathname === navLink.href)}])}>
                                <Icon name={navLink.iconName} class="size-6 lg:hidden"/>
                                <span class="hidden md:block">
                                    {navLink.label}
                                </span>
                            </a>
                        </li>
                ))}
            </ul>
        </nav>
        <div>

        </div>
    </div>
</header>

<slot/>

<footer class="mt-8 px-2 py-4 flex justify-between items-center flex-col gap-4 lg:flex-row lg:px-4">
    <menu class="flex gap-3">
        {socialLinks.map(socialLink => (
                <li>
                    <a href={socialLink.href} target="_blank" rel="noopener noreferrer"
                       class={cn("size-6 text-muted-foreground hover:text-foreground transition-colors", socialLink.className)}
                       aria-label={socialLink.label}>
                        <Icon name={socialLink.iconName} class="size-6"/>
                    </a>
                </li>
        ))}
    </menu>
    <div class="container text-center text-sm text-muted-foreground">
        <p>&copy; {new Date().getFullYear()} Cajetan Grill. All rights reserved.</p>
        <p>
            Made with 💜 using <a href="https://astro.build" class="underline hover:text-primary">Astro</a>,{' '}
            <a href="https://reactjs.org" class="underline hover:text-primary">React</a>,{' '}
            <a href="https://ui.shadcn.com/" class="underline hover:text-primary">shadcn/ui</a>, and{' '}
            <a href="https://magicui.design/" class="underline hover:text-primary">Magic UI</a>.
        </p>
    </div>
    <menu class="flex text-center">
        <li>
            <ModeToggle client:load/>
        </li>
    </menu>
</footer>
</body>
</html>