{
	"extends": "astro/tsconfigs/strictest",
	"include": [
		".astro/types.d.ts",
		"**/*"
	],
	"exclude": [
		"dist"
	],
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"$data": [
				"./src/data"
			],
			"$data/*": [
				"./src/data/*"
			],
			"$layouts": [
				"./src/layouts"
			],
			"$layouts/*": [
				"./src/layouts/*"
			],
			"$lib": [
				"./src/lib"
			],
			"$lib/*": [
				"./src/lib/*"
			]
		}
	}
}
